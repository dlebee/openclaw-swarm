# Ensure shell scripts and Dockerfiles always use LF line endings
# regardless of the developer's OS (prevents broken Docker images on Windows)
*.sh        text eol=lf
Dockerfile* text eol=lf
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
